# BookSlot environment variables

# App URL (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-in-production

# Database (SQLite file locally, Turso/libsql in production)
DATABASE_URL=file:./data/bookslot.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Email reminders (optional — logs to console if missing)
# RESEND_API_KEY=re_...
# EMAIL_FROM=BookSlot <noreply@yourdomain.com>

# Cron protection for /api/cron/reminders
CRON_SECRET=change-me-in-production

# Optional: address free-plan shops can email to ask for Pro (dashboard → Widget)
# NEXT_PUBLIC_SALES_EMAIL=
